# Copy to `.env` and fill in when ready. All are OPTIONAL — the site works without them.

# Canonical production URL (used for SEO canonical/OG tags)
VITE_SITE_URL=https://druvabadminton.com

# Lead / enquiry form delivery endpoint (backend API, CRM webhook, or Google
# Apps Script). If blank, the contact form gracefully falls back to WhatsApp.
VITE_LEAD_API_URL=

# Analytics — no tag loads unless an ID is set here.
VITE_GA4_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=
